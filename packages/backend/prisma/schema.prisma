generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model expenses {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  amount     Decimal  @db.Decimal
  category   String
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_expenses_users")
  @@index([user_id])
}

model users {
  id              Int        @id @default(autoincrement())
  username        String     @unique
  budget          Decimal?   @db.Decimal
  hashed_password String
  expenses        expenses[]
  @@index([username])
}
